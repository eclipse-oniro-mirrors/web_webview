import("//build/test.gni")
import("../../../web_aafwk.gni")

module_output_path = "webview/color_chooser"

ohos_unittest("ark_web_color_chooser_callback_wrapper_test") {
  module_out_path = module_output_path
  sources = [
    "ark_web_color_chooser_callback_wrapper_test.cpp",
  ]

  include_dirs = [
    "${target_gen_dir}/../../../ohos_glue",
    "${target_gen_dir}/../../../ohos_glue/ohos_nweb/bridge",
    "${target_gen_dir}/../../../ohos_nweb",
    "$webview_path/ohos_glue",
  ]

  deps = [
    "$webview_path/ohos_glue:ohos_base_glue_source",
    "$webview_path/ohos_glue:ohos_nweb_glue_source",
  ]

  deps += [
    "$webview_path/ohos_nweb:libnweb",
  ]

  external_deps = [
    "c_utils:utils",
    "googletest:gmock_main",
    "googletest:gtest_main",
    "hilog:libhilog",
  ]
}

group("unittest") {
  testonly = true
  deps = [
    ":ark_web_color_chooser_callback_wrapper_test",
  ]
}
